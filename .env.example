# ========================================================
# BreathePure Configuration
# ========================================================

# Project metadata
PROJECT_NAME="BreathePure"
TAGLINE="Smarter Air. Healthier Life."

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000

# Google Gemini API Key (Optional for Demo Mode)
# If left empty, BreathePure automatically activates high-fidelity
# Deterministic Demo Mode with zero external API calls.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Cache TTL for Weather / AQI Telemetry in seconds (default: 15 minutes)
CACHE_TTL_SECONDS=900
